# ElevenLabs Configuration
# Get your agent at: https://try.elevenlabs.io/reachy-mini-agents
# API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Agent ID from ElevenLabs dashboard
# Create an agent at: https://try.elevenlabs.io/reachy-mini-agents
ELEVENLABS_AGENT_ID=

# Emotion Detection Settings
# Enable automatic emotion detection from agent responses to trigger robot expressions
ENABLE_EMOTION_DETECTION=true

# Minimum confidence threshold (0.0-1.0) for triggering emotion-based actions
# Lower values = more sensitive, higher values = only strong emotions trigger actions
EMOTION_CONFIDENCE_THRESHOLD=0.3

# Cooldown period in seconds between emotion-triggered actions
# Prevents the robot from constantly moving when multiple emotions are detected
EMOTION_COOLDOWN_SECONDS=3.0

# Idle Emotion Settings
# Enable continuous idle emotions (subtle expressions when not actively responding)
ENABLE_IDLE_EMOTIONS=true

# Minimum delay in seconds between idle emotions
IDLE_EMOTION_MIN_DELAY=3.0

# Maximum delay in seconds between idle emotions
IDLE_EMOTION_MAX_DELAY=8.0
